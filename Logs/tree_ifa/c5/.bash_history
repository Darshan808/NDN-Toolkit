while true; do         r=$(shuf -i 1-100 -n 1);         if [ $r -le 40 ]; then             ndnpeek -p /ndn/video/$(shuf -i 1-10 -n 1) &         elif [ $r -le 65 ]; then             ndnpeek -p /ndn/image/$(shuf -i 1-8 -n 1) &         elif [ $r -le 80 ]; then             ndnpeek -p /ndn/text/$(shuf -i 1-15 -n 1) &         else             ndnpeek -p /ndn/file/$(shuf -i 1-20 -n 1) &         fi;         sleep 0.45;     done
